                                        <td class="text-center"
                                            style="background-color:#FCA5A5; color:#7F1D1D; font-weight:700;">
                                            @item.Avg3Days
                                        </td>

                                        <td class="text-center">
                                            @item.Avg14Days
                                        </td>

                                        <td class="text-center">
                                            @item.Avg30Days
                                        </td>
                                        <td class="text-center">
    @if (!string.IsNullOrWhiteSpace(item.GraphUrl))
    {
        <a href="@item.GraphUrl"

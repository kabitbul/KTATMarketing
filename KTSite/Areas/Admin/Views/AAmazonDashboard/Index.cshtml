</div>
    <div class="dashboard-chart-card">

        <div class="dashboard-chart-header">
            <div>
                <h2 class="dashboard-chart-title">
                    Daily Units Sold
                </h2>

                <div class="dashboard-chart-subtitle">
                    Last 60 days — total displayed by default
                </div>
            </div>
        </div>

        <div class="dashboard-chart-container">
            <canvas id="dailySalesChart"></canvas>
        </div>

    </div>

    <div class="dashboard-chart-card">

        <div class="dashboard-chart-header">
            <div>
                <h2 class="dashboard-chart-title">
                    Monthly Units Sold
                </h2>

                <div class="dashboard-chart-subtitle">
                    Last 18 months — stacked by store
                </div>
            </div>
        </div>

        <div class="dashboard-chart-container">
            <canvas id="monthlySalesChart"></canvas>
        </div>

    </div>

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>

    <script>
        const dailyLabels = @Html.Raw(dailyLabelsJson);
        const dailySeries = @Html.Raw(dailySeriesJson);

        const monthlyLabels = @Html.Raw(monthlyLabelsJson);
        const monthlySeries = @Html.Raw(monthlySeriesJson);

        const storeColors = {
            KT: "#24457B",
            KESEM: "#E47F47",
            GORAL: "#8A7535",
            WEBRUSH: "#168C92"
        };

        function getStoreColor(storeName, index) {
            const normalizedName =
                (storeName || "").trim().toUpperCase();

            if (storeColors[normalizedName]) {
                return storeColors[normalizedName];
            }

            const fallbackColors = [
                "#4F46E5",
                "#DC2626",
                "#059669",
                "#7C3AED",
                "#D97706",
                "#0891B2"
            ];

            return fallbackColors[index % fallbackColors.length];
        }

        function sumSeries(seriesCollection) {
            if (!seriesCollection.length) {
                return [];
            }

            const valueCount =
                seriesCollection[0].values.length;

            const totals = new Array(valueCount).fill(0);

            seriesCollection.forEach(series => {
                series.values.forEach((value, index) => {
                    totals[index] += value;
                });
            });

            return totals;
        }

        const dailyTotalValues =
            sumSeries(dailySeries);

        const dailyDatasets = [
            {
                label: "TOTAL",
                data: dailyTotalValues,
                borderColor: "#111827",
                backgroundColor: "#111827",
                borderWidth: 3,
                pointRadius: 1,
                pointHoverRadius: 5,
                tension: 0.25,
                hidden: false
            },
            ...dailySeries.map((series, index) => {
                const color =
                    getStoreColor(series.storeName, index);

                return {
                    label: series.storeName,
                    data: series.values,
                    borderColor: color,
                    backgroundColor: color,
                    borderWidth: 2,
                    pointRadius: 1,
                    pointHoverRadius: 5,
                    tension: 0.25,

                    // Total is shown by default.
                    // Click a store in the legend to display it.
                    hidden: true
                };
            })
        ];

        new Chart(
            document.getElementById("dailySalesChart"),
            {
                type: "line",

                data: {
                    labels: dailyLabels,
                    datasets: dailyDatasets
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: "index",
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            position: "top"
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return `${context.dataset.label}: ${context.parsed.y.toLocaleString()} units`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0
                            },
                            title: {
                                display: true,
                                text: "Units"
                            }
                        },
                        x: {
                            ticks: {
                                maxTicksLimit: 15
                            }
                        }
                    }
                }
            }
        );

        const monthlyDatasets =
            monthlySeries.map((series, index) => {
                const color =
                    getStoreColor(series.storeName, index);

                return {
                    label: series.storeName,
                    data: series.values,
                    backgroundColor: color,
                    borderColor: color,
                    borderWidth: 1
                };
            });

        new Chart(
            document.getElementById("monthlySalesChart"),
            {
                type: "bar",

                data: {
                    labels: monthlyLabels,
                    datasets: monthlyDatasets
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: "index",
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            position: "top"
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return `${context.dataset.label}: ${context.parsed.y.toLocaleString()} units`;
                                },
                                footer: function(items) {
                                    const total = items.reduce(
                                        (sum, item) =>
                                            sum + item.parsed.y,
                                        0
                                    );

                                    return `Total: ${total.toLocaleString()} units`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            stacked: true
                        },
                        y: {
                            stacked: true,
                            beginAtZero: true,
                            ticks: {
                                precision: 0
                            },
                            title: {
                                display: true,
                                text: "Units"
                            }
                        }
                    }
                }
            }
        );
    </script>
}
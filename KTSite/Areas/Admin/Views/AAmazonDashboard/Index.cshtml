@using System.Globalization
@model KTSite.Models.AAmzMainDashboardVM
@functions {
    private string? GetRestockInventoryUrl(string? store, string? marketplace)
    {
        var storeName = store?.Trim().ToUpperInvariant();
        var market = marketplace?.Trim().ToUpperInvariant();

        return (storeName, market) switch
        {
            ("KT", "US") =>
                "/Admin/AAmzInventoryKTUS?showRestock=true",

            ("KT", "CA") =>
                "/Admin/AAmzInventoryKTCA?showRestock=true",

            ("KESEM", "US") =>
                "/Admin/AAmzInventoryLitalUS?showRestock=true",

            ("GORAL", "US") =>
                "/Admin/AAmzInventoryGoralUS?showRestock=true",

            ("WEBRUSH", "US") =>
                "/Admin/AAmzInventoryWebrushUS?showRestock=true",

            _ => null
        };
    }
}
@using System.Text.Json

@{
    ViewData["Title"] = "Amazon Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var jsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };

    string dailyLabelsJson =
        JsonSerializer.Serialize(Model.DailyLabels, jsonOptions);

    string dailySeriesJson =
        JsonSerializer.Serialize(Model.DailySeries, jsonOptions);

    string monthlyLabelsJson =
        JsonSerializer.Serialize(Model.MonthlyLabels, jsonOptions);

    string monthlySeriesJson =
        JsonSerializer.Serialize(Model.MonthlySeries, jsonOptions);
}

<style>
    .dashboard-page {
        padding: 20px 10px 40px;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        gap: 15px;
    }

    .dashboard-title {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        color: #1f2937;
    }

    .dashboard-updated {
        color: #6b7280;
        font-size: 13px;
    }

    .dashboard-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 14px;
        margin-bottom: 20px;
    }

    .dashboard-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 17px;
        box-shadow: 0 2px 7px rgba(0, 0, 0, 0.05);
    }

    .dashboard-card-total {
        border-top: 4px solid #111827;
    }

    .dashboard-card-title {
        margin-bottom: 6px;
        color: #6b7280;
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .dashboard-card-value {
        color: #111827;
        font-size: 25px;
        font-weight: 700;
    }

    .dashboard-card-subtitle {
        margin-top: 5px;
        color: #6b7280;
        font-size: 12px;
    }

    .dashboard-chart-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 18px;
        margin-bottom: 20px;
        box-shadow: 0 2px 7px rgba(0, 0, 0, 0.05);
    }

    .dashboard-chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 12px;
    }

    .dashboard-chart-title {
        margin: 0;
        color: #1f2937;
        font-size: 18px;
        font-weight: 700;
    }

    .dashboard-chart-subtitle {
        color: #6b7280;
        font-size: 12px;
    }

    .dashboard-chart-container {
        position: relative;
        width: 100%;
        height: 340px;
    }

    .dashboard-table {
        width: 100%;
        border-collapse: collapse;
    }

        .dashboard-table th,
        .dashboard-table td {
            padding: 11px 12px;
            border-bottom: 1px solid #e5e7eb;
            text-align: right;
        }

            .dashboard-table th:first-child,
            .dashboard-table td:first-child {
                text-align: left;
            }

        .dashboard-table th {
            color: #4b5563;
            font-size: 12px;
            text-transform: uppercase;
        }

    .dashboard-table-total {
        font-weight: 700;
        background: #f9fafb;
    }

    @@media (max-width: 768px) {
        .dashboard-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .dashboard-chart-container {
            height: 290px;
        }
    }

    .dashboard-date-filter {
        display: flex;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 10px;
    }

    .date-filter-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .date-filter-field label {
            margin: 0;
            color: #6b7280;
            font-size: 12px;
            font-weight: 600;
        }

        .date-filter-field input {
            min-width: 145px;
        }
        .restock-alert-card {
    border-left: 5px solid #dc2626;
}

.restock-alert-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 15px;
}

.restock-summary-badge {
    padding: 6px 10px;
    border-radius: 999px;
    background: #fee2e2;
    color: #991b1b;
    font-size: 13px;
}

.restock-days {
    color: #dc2626;
    font-weight: 700;
}

.restock-more {
    margin-top: 12px;
    color: #6b7280;
    font-size: 13px;
    text-align: right;
}

    .restock-store-link {
        color: #0d6efd;
        text-decoration: underline;
        cursor: pointer;
    }

        .restock-store-link:hover {
            color: #0a58ca;
        }
</style>

<div class="dashboard-page">

    <div class="dashboard-header">
        <div>
            <h1 class="dashboard-title">Amazon Stores Dashboard</h1>
            <form method="get"
                  asp-area="Admin"
                  asp-controller="AAmazonDashboard"
                  asp-action="Index"
                  class="dashboard-date-filter">

                <div class="date-filter-field">
                    <label for="fromDate">From</label>

                    <input type="date"
                           id="fromDate"
                           name="fromDate"
                           value="@Model.DailyFromDate.ToString("yyyy-MM-dd")"
                           class="form-control" />
                </div>

                <div class="date-filter-field">
                    <label for="toDate">To</label>

                    <input type="date"
                           id="toDate"
                           name="toDate"
                           value="@Model.DailyToDate.ToString("yyyy-MM-dd")"
                           class="form-control" />
                </div>

                <button type="submit" class="btn btn-primary">
                    Apply
                </button>

                <a asp-area="Admin"
                   asp-controller="AAmazonDashboard"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    60 Days
                </a>
            </form>
            <div class="dashboard-updated">
                Updated: @Model.GeneratedAt.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>
    </div>

    <div class="dashboard-cards">

        <div class="dashboard-card dashboard-card-total">
            <div class="dashboard-card-title">
                Total Inventory Value
            </div>

            <div class="dashboard-card-value">
                @Model.TotalInventoryCost.ToString("C0", CultureInfo.GetCultureInfo("en-US"))
            </div>

            <div class="dashboard-card-subtitle">
                FBA + AWD + On The Way
            </div>
        </div>

        @foreach (var store in Model.Stores)
        {
            <div class="dashboard-card">
                <div class="dashboard-card-title">
                    @store.StoreName
                </div>

                <div class="dashboard-card-value">
                    @store.InventoryCost.ToString("C0", CultureInfo.GetCultureInfo("en-US"))
                </div>

                <div class="dashboard-card-subtitle">
                    @store.InventorySharePercent.ToString("0.0")%
                    of inventory ·
                    @store.UnitsLast60Days.ToString("N0")
                    units in 60 days
                </div>
            </div>
        }
    </div>
    @if (Model.RestockAlerts.Any())
{
    <div class="dashboard-chart-card restock-alert-card">

        <div class="dashboard-chart-header">
            <div>
                <h2 class="dashboard-chart-title">
                    Restock Required
                </h2>

                <div class="dashboard-chart-subtitle">
                    @Model.RestockAlerts.Count products require attention
                </div>
            </div>
        </div>

        <div class="restock-alert-summary">
            @foreach (var group in Model.RestockAlerts
                .GroupBy(x => new { x.StoreName, x.Marketplace }))
            {
                <span class="restock-summary-badge">
                    @group.Key.StoreName @group.Key.Marketplace:
                    <strong>@group.Count()</strong>
                </span>
            }
        </div>

        <div style="overflow-x:auto;">
            <table class="dashboard-table">
                <thead>
                    <tr>
                        <th>Store</th>
                        <th>Marketplace</th>
                        <th>ASIN</th>
                        <th>Product</th>
                        <th>Available</th>
                        <th>Inbound</th>
                        <th>AWD</th>
                        <th>On The Way</th>
                        <th>14-Day Avg</th>
                        <th>Days To OOS</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var alert in Model.RestockAlerts.Take(10))
                    {
                        <tr>
                            <td>
                            @{
                        var inventoryUrl = GetRestockInventoryUrl(
                                alert.StoreName,
                                alert.Marketplace);
                             }

    @if (!string.IsNullOrWhiteSpace(inventoryUrl))
    {
                                        <a href="@inventoryUrl"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="restock-store-link">
                                            @alert.StoreName
                                        </a>
    }
    else
    {
        @alert.StoreName
    }
</td>
                            <td>@alert.Marketplace</td>
                            <td>@alert.Asin</td>
                            <td>@alert.ProductName</td>
                            <td>@alert.AvailableQty</td>
                            <td>@alert.InboundQty</td>
                            <td>
                                @(alert.AWDAvailableQty + alert.AWDInboundQty)
                            </td>
                            <td>@alert.OnTheWayQty</td>
                            <td>@alert.Average14Days</td>
                            <td class="restock-days">
                                @alert.DaysToOOS
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.RestockAlerts.Count > 10)
        {
            <div class="restock-more">
                Showing 10 of @Model.RestockAlerts.Count alerts
            </div>
        }

    </div>
}

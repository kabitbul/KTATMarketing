@model KTSite.Models.AAmzOrderSearchVM

@{
    ViewData["Title"] = "Order Search";

    string GetStoreName(int storeId)
    {
        return storeId switch
        {
            1 => "KT",
            2 => "LITAL",
            3 => "GORAL",
            4 => "WEBRUSH",
            _ => storeId.ToString()
        };
    }
}


<div class="container-fluid mt-3">

    <!-- TITLE -->
    <div class="mb-3">

        <h2 class="mb-0">
            Order Search
        </h2>

        <div class="text-muted">
            Search Amazon sales by date, ASIN and store
        </div>

    </div>


    <!-- QUICK DATE BUTTONS -->
    <div class="mb-3">

        <button type="button"
                class="btn btn-outline-secondary btn-sm me-1"
                onclick="setDateRange('today')">

            Today

        </button>


        <button type="button"
                class="btn btn-outline-secondary btn-sm me-1"
                onclick="setDateRange('yesterday')">

            Yesterday

        </button>


        <button type="button"
                class="btn btn-outline-secondary btn-sm me-1"
                onclick="setDateRange('7')">

            Last 7 Days

        </button>


        <button type="button"
                class="btn btn-outline-secondary btn-sm"
                onclick="setDateRange('30')">

            Last 30 Days

        </button>

    </div>



    <!-- SEARCH FORM -->
    <form method="get"
          asp-area="Admin"
          asp-controller="AAmzOrderSearch"
          asp-action="Index"
          id="orderSearchForm">

        <div class="card mb-3 shadow-sm">

            <div class="card-body">

                <div class="row g-3">


                    <!-- FROM DATE -->
                    <div class="col-xl-2 col-md-3">

                        <label class="form-label fw-semibold">
                            From Date
                        </label>

                        <input type="date"
                               class="form-control"
                               id="fromDate"
                               name="fromDate"
                               value="@Model.FromDate.ToString("yyyy-MM-dd")" />

                    </div>



                    <!-- TO DATE -->
                    <div class="col-xl-2 col-md-3">

                        <label class="form-label fw-semibold">
                            To Date
                        </label>

                        <input type="date"
                               class="form-control"
                               id="toDate"
                               name="toDate"
                               value="@Model.ToDate.ToString("yyyy-MM-dd")" />

                    </div>



                    <!-- SEARCH TEXT -->
                    <div class="col-xl-3 col-md-3">

                        <label class="form-label fw-semibold">
                            ASIN / China Name
                        </label>

                        <input type="text"
                               class="form-control"
                               name="searchText"
                               value="@Model.SearchText"
                               placeholder="ASIN or China Name..." />

                    </div>



                    <!-- STORE -->
                    <div class="col-xl-2 col-md-3">

                        <label class="form-label fw-semibold">
                            Store
                        </label>

                        <select class="form-select"
                                name="storeId">

                            <option value="">
                                All Stores
                            </option>


                            <option value="1"
                                    selected="@(Model.StoreId == 1 ? "selected" : null)">
                                KT
                            </option>


                            <option value="2"
                                    selected="@(Model.StoreId == 2 ? "selected" : null)">
                                LITAL
                            </option>


                            <option value="3"
                                    selected="@(Model.StoreId == 3 ? "selected" : null)">
                                GORAL
                            </option>


                            <option value="4"
                                    selected="@(Model.StoreId == 4 ? "selected" : null)">
                                WEBRUSH
                            </option>

                        </select>

                    </div>



                    <!-- BUTTONS -->
                    <div class="col-xl-3 col-md-12 d-flex align-items-end">

                        <button type="submit"
                                class="btn btn-primary me-2">

                            Search

                        </button>


                        <a asp-area="Admin"
                           asp-controller="AAmzOrderSearch"
                           asp-action="Index"
                           class="btn btn-outline-secondary">

                            Clear

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </form>



    <!-- SUMMARY -->
    <div class="row g-3 mb-3">


        <!-- UNITS -->
        <div class="col-xl-2 col-md-3 col-sm-6">

            <div class="card shadow-sm h-100">

                <div class="card-body py-2">

                    <div class="text-muted small">
                        Units Sold
                    </div>

                    <div class="fs-4 fw-bold">
                        @Model.TotalUnits
                    </div>

                </div>

            </div>

        </div>


        <!-- ROWS -->
        <div class="col-xl-2 col-md-3 col-sm-6">

            <div class="card shadow-sm h-100">

                <div class="card-body py-2">

                    <div class="text-muted small">
                        Rows
                    </div>

                    <div class="fs-4 fw-bold">
                        @Model.TotalRows
                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- LIMIT WARNING -->
    @if (Model.IsLimited)
    {
        <div class="alert alert-warning">

            More than 1,000 rows matched the search.

            Only the newest 1,000 rows are displayed.

            Please narrow the date range or enter an ASIN.

        </div>
    }



    <!-- RESULTS -->
    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">

            <span class="fw-bold">
                Search Results
            </span>


            @if (Model.TotalRows > 0)
            {
                <span class="text-muted small">

                    Showing
                    @Math.Min(Model.TotalRows, 1000)
                    of
                    @Model.TotalRows
                    rows

                </span>
            }

        </div>

        <table class="table table-hover table-sm align-middle mb-0">

            <thead class="table-light">

                <tr>

                    <th style="width:70px;">
                        Image
                    </th>

                    <th style="width:160px;">
                        Purchase Date
                    </th>

                    <th style="width:90px;">
                        Store
                    </th>

                    <th style="width:130px;">
                        ASIN
                    </th>

                    <th>
                        China Name
                    </th>

                    <th style="width:70px;"
                        class="text-center">
                        Qty
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model.Orders != null &&
                                Model.Orders.Any())
                {
                    foreach (var order in Model.Orders)
                    {
                        string storeName =
                        GetStoreName(order.StoreId);

                        string amazonUrl =
                        $"https://www.amazon.com/dp/{order.Asin}";

                        <tr>

                            <!-- IMAGE -->
                            <td class="text-center">

                                @if (!string.IsNullOrWhiteSpace(order.ImageUrl))
                                {
                                    <img src="@order.ImageUrl"
                                         style="width:50px;
                                                    height:50px;
                                                    object-fit:contain;" />
                                }

                            </td>


                            <!-- DATE -->
                            <td style="white-space:nowrap;">

                                @order.PurchaseDate.ToString(
                                "dd/MM/yyyy HH:mm")

                    </td>


                    <!-- STORE -->
                    <td>

                        @storeName

                    </td>


                    <!-- ASIN -->
                    <td>

                        @if (!string.IsNullOrWhiteSpace(order.Asin))
                                {
                                    <a href="@amazonUrl"
                                       target="_blank"
                                       class="fw-bold text-decoration-none">

                                        @order.Asin

                                    </a>
                                }

                            </td>


                            <!-- CHINA NAME -->
                            <td>

                                @order.ChinaName

                            </td>


                            <!-- QTY -->
                            <td class="text-center fw-bold">

                                @order.Quantity

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="6"
                            class="text-center text-muted py-5">

                            No orders found for the selected filters

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>



<script>

    function formatDate(date) {

        const year =
            date.getFullYear();

        const month =
            String(
                date.getMonth() + 1
            ).padStart(2, '0');

        const day =
            String(
                date.getDate()
            ).padStart(2, '0');

        return `${year}-${month}-${day}`;
    }



    function setDateRange(range) {

        const today =
            new Date();


        let from =
            new Date(today);

        let to =
            new Date(today);



        if (range === 'today') {

            // today -> today

        }

        else if (range === 'yesterday') {

            from.setDate(
                today.getDate() - 1
            );

            to.setDate(
                today.getDate() - 1
            );

        }

        else if (range === '7') {

            from.setDate(
                today.getDate() - 6
            );

        }

        else if (range === '30') {

            from.setDate(
                today.getDate() - 29
            );

        }



        document
            .getElementById('fromDate')
            .value =
                formatDate(from);


        document
            .getElementById('toDate')
            .value =
                formatDate(to);


        document
            .getElementById('orderSearchForm')
            .submit();
    }

</script>